  m_Script: {fileID: 11500000, guid: 41a6cd280718e3d45b863077bc3e36c4, type: 3}
  m_Name: Dialogo velho
  m_EditorClassIdentifier: 
  characterName: Velho
  sentences:
  - "There\u2019s a knife hidden behind a large tree, near the baron\u2019s mansion...
    it\u2019s stuck into the trunk."
  - "That\u2019s not just iron, Zumbi... it\u2019s courage, kept safe. Use it wisely.
    One day, you\u2019re going to set us all free from this."
  - "Oh, and one more thing, Zombie: if you want to escape, you\u2019ll have to find
    the key to open the gate."
  - "But pay attention: the key you\u2019ll need is inside the mansion."
  - "So, if you\u2019re going to get it, go at night, because it\u2019s always surrounded
    by guards during the day."
  npcSprite: {fileID: 5435608014139152121, guid: 632c8667d5ce30b45a9a6990f92613fa, type: 3}
